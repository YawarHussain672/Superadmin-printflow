# ─────────────────────────────────────────────────────────────────────────────
# Axis Max Life — Print Management System
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
# Use the "Pooled connection" string for production
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# NEXTAUTH_URL must match your deployment URL exactly
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# ─── AWS S3 (File Uploads — PO, Challan, Invoice) ──────────────────────────
# Get from: https://console.aws.amazon.com/s3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="ap-south-1"
AWS_BUCKET=""
AWS_URL=""

# ─── Pusher (Real-time Notifications) ────────────────────────────────────────
# Get from: https://dashboard.pusher.com
NEXT_PUBLIC_PUSHER_APP_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
PUSHER_APP_ID=""
PUSHER_SECRET=""

# ─── App Settings ────────────────────────────────────────────────────────────
# Used during database seeding only
ADMIN_EMAIL="youremail@.com"
ADMIN_PASSWORD="yourpass@123"

# ─── Email (SMTP — Outlook/AWS SES) ──────────────────────────────────────────
# For AWS SES: Host = email-smtp.{region}.amazonaws.com, Port = 587
# For Outlook: Host = smtp-mail.outlook.com, Port = 587
MAIL_MAILER="smtp"
MAIL_HOST="smtp-mail.outlook.com"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Printflow"
MAIL_ENCRYPTION="tls"
